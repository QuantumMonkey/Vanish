node_modules/
# package-lock.json is deliberately TRACKED (SEC-4). It is the only record of
# which dependency builds a release was made from, and it carries the integrity
# hashes that make a substituted package detectable. This is an application
# repo, not a library.
.vscode/
dist/
*.log
# Suite output, per machine. Re-derivable, sometimes large, and the sandbox
# run leaves .txt transcripts here that the *.log rule above does not catch.
test/logs/
.claude/settings.local.json
.security-reports/

# Per-project tooling cruft copied in by init-project.ps1 -- belongs to
# the operating system (D:\Claude setups), not the Vanish project repo.
.claude/skills/
skills-archive/
init-project.ps1
# Graphify knowledge-graph output (generated, re-derivable)
graphify-out/
.env
.env.*
!.env.example

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Antigravity exploration scratch (never merged; findings return via bd)
scratch/

# Agent tooling rules copied in per-project; belongs to the tooling, not Vanish
.agent/

# winget package export left over from the OPEN-02 research session (2026-07-11).
# The findings live in bd vanish-uninstaller-1gi and corrections.json; the raw
# export is not a project artefact.
test_export.json

# Working artefacts - never part of the shipped app
scratch/
skills-archive/
graphify-out/
test_export.json
dist/
release/

# Mutation harness crash journal (test/mutation/run-mutants.js). Transient by
# design: it exists only while a mutant is planted, and the next run uses it to
# put the file back if a previous one was killed mid-flight.
test/mutation/.in-flight.json
test/mutation/.in-flight.bak
