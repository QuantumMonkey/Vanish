    },
    {
      "match": { "displayName": "7-Zip", "publisher": "Igor Pavlov" },
      "silentArgs": "/S",
      "source": "NSIS uninstaller",
      "meta": { "verified": "community", "note": "MSI builds of 7-Zip fall through to the /qn heuristic instead." }
    },
    {
      "match": { "displayName": "Visual Studio Code", "publisher": "Microsoft" },
